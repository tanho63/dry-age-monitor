[Unit]
Description=Upload monitor data to S3 via rclone
After=multi-user.target
Wants=multi-user.target

[Service]
Type=simple
User=tan
SupplementaryGroups=i2c
WorkingDirectory=/home/tan/dry-age-monitor
ExecStart=/home/tan/dry-age-monitor/monitor/upload_s3.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
